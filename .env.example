# Gateway API key (used for OpenAI-compatible upstream authentication)
GATEWAY_API_KEY=replace-me

# Qwen (OpenAI-compatible endpoint, e.g. local vLLM)
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=replace-me
QWEN_MODEL=replace-with-vllm-model-id

# StepFun
STEP_BASE_URL=https://api.stepfun.com/step_plan/v1
STEP_API_KEY=replace-me
STEP_MODEL=step-3.7-flash

# Server
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9000
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:9000","http://localhost:9000"]
MAX_REQUEST_BODY_BYTES=12582912

# Optional Product API -> Gateway override (Spark defaults to local port)
COFOUNDER_GATEWAY_URL=http://127.0.0.1:9000
COFOUNDER_GATEWAY_API_KEY=replace-me
PRODUCT_DATA_DIR=data
PRODUCT_MAX_ARTIFACT_BYTES=1048576

# Request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=300

# Audit log directory and token for GET /audit/recent (endpoint disabled when unset)
AUDIT_DIR=data/audit
GATEWAY_AUDIT_TOKEN=

# Independent Product API identity (replace both with distinct random values)
PRODUCT_API_TOKEN=replace-me-founder-token
PRODUCT_API_BRIDGE_TOKEN=replace-me-bridge-token
PRODUCT_FOUNDER_ID=founder
# Configure the already verified Feishu pairing; do not derive identity from message text.
FEISHU_APP_ID=
FEISHU_OPEN_ID=
FEISHU_TENANT_KEY=
# Alternatively, point to the private persisted tenant identity file.
FEISHU_TENANT_FILE=
